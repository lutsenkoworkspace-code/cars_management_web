.max-w-2xl.mx-auto.mt-10.p-6.bg-white.rounded-lg.shadow-md
  %h1.text-2xl.font-bold.mb-6 Add New Car

  = form_with model: @car, class: "space-y-4" do |f|
    - if @car.errors.any?
      .bg-red-50.text-red-500.p-4.rounded.mb-4
        %h2= "#{pluralize(@car.errors.count, "error")} prohibited this car from being saved:"
        %ul
          - @car.errors.full_messages.each do |message|
            %li= message

    %div
      = f.label :make, class: "block text-sm font-medium text-gray-700"
      = f.text_field :make, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 border p-2"
    
    .grid.grid-cols-2.gap-4
      %div
        = f.label :model, class: "block text-sm font-medium text-gray-700"
        = f.text_field :model, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2"
      %div
        = f.label :year, class: "block text-sm font-medium text-gray-700"
        = f.number_field :year, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2"
        
    %div
      = f.label :odometer, class: "block text-sm font-medium text-gray-700"
      = f.number_field :odometer, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2"

    %div
      = f.label :price, class: "block text-sm font-medium text-gray-700"
      = f.number_field :price, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2"

    %div
      = f.label :description, class: "block text-sm font-medium text-gray-700"
      = f.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2"

    .mt-6
      = f.submit "Create Car", class: "w-full bg-indigo-600 text-white font-bold py-2 px-4 rounded hover:bg-indigo-700 cursor-pointer"
