.min-h-screen.bg-gray-50.flex.flex-col.justify-center.py-12.sm:px-6.lg:px-8
  .sm:mx-auto.sm:w-full.sm:max-w-md
    %h2.mt-6.text-center.text-3xl.font-bold.tracking-tight.text-gray-900
      = t('devise.sessions.title')
    %p.mt-2.text-center.text-sm.text-gray-600
      = t('devise.sessions.subtitle')

  .mt-8.sm:mx-auto.sm:w-full.sm:max-w-md
    .bg-white.py-8.px-4.shadow.sm:rounded-lg.sm:px-10
      = form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f|
        
        %div
          = f.label :email, t('devise.registrations.email'), class: "block text-sm font-medium text-gray-700"
          .mt-1
            = f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 border p-2"

        %div
          = f.label :password, t('devise.registrations.password'), class: "block text-sm font-medium text-gray-700"
          .mt-1
            = f.password_field :password, autocomplete: "current-password", placeholder: t('devise.registrations.login_password_placeholder'), class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 border p-2"

        .flex.items-center.justify-between
          .flex.items-center
            = f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"
            = f.label :remember_me, t('devise.sessions.remember_me'), class: "ml-2 block text-sm text-gray-900"

          .text-sm
            = link_to t('devise.sessions.forgot_password'), "#", class: "font-medium text-blue-600 hover:text-blue-500"

        %div
          = f.submit t('nav.login'), class: "flex w-full justify-center rounded-md bg-blue-600 py-2 px-4 text-sm font-bold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 cursor-pointer transition"

      .mt-6
        .relative
          .absolute.inset-0.flex.items-center
            .w-full.border-t.border-gray-300
          .relative.flex.justify-center.text-sm
            %span.bg-white.px-2.text-gray-500
              = t('devise.sessions.no_account')

        .mt-6.text-center
          = link_to t('nav.sign_up'), new_registration_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-500"

  .mt-8.text-center
    = back_to_home_button
