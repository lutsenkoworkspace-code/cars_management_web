.max-w-4xl.mx-auto.py-12.px-4
  .flex.justify-between.items-center.mb-8
    %div
      %h1.text-3xl.font-bold.text-gray-900= t('user_searches.title')
      %p.text-gray-600.mt-1= t('user_searches.subtitle')
    = link_to t('nav.new_search'), search_page_path, class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 font-medium text-sm transition"

  - if @user_searches.any?
    .space-y-4
      - @user_searches.each do |user_search|
        .bg-white.p-6.rounded-lg.border.border-gray-200.shadow-sm.flex.justify-between.items-center
          %div
            %h3.text-lg.font-bold.text-gray-900= user_search.name
            .text-sm.text-gray-500.mt-1
              = format_query_params(user_search.query_params)
            %p.text-xs.text-gray-400.mt-2
              = "#{t('user_searches.created_at')} #{l(user_search.created_at, format: :short)}"
          
          .flex.gap-2
            = link_to t('user_searches.actions.run'), search_page_path(car_search: user_search.query_params), class: "px-4 py-2 bg-blue-600 text-white rounded text-xs font-bold hover:bg-blue-700 transition"
            
            = button_to t('actions.delete'), user_search_path(user_search), method: :delete, data: { confirm: t('actions.confirm_delete') }, class: "px-4 py-2 border border-gray-200 rounded text-gray-600 hover:bg-gray-50 text-xs font-medium transition"
  - else
    .text-center.py-20.bg-gray-50.rounded-xl.border-2.border-dashed.border-gray-200
      %p.text-gray-500= t('user_searches.no_searches')

  .mt-8
    = back_to_home_button
